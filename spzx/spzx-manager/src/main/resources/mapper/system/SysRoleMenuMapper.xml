<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manager.mapper.SysRoleMenuMapper">
    <insert id="doAssign">
        insert into sys_role_menu(role_id,menu_id,is_half)
        values
        <foreach collection="menuIdList" item="menuInfo" separator=",">
            (#{roleId},#{menuInfo.menuId},#{menuInfo.isHalf})
        </foreach>
    </insert>
    <delete id="deleteByRoleId">
        delete from sys_role_menu where role_id = #{roleId}
    </delete>
    <select id="findMenuIdByRoleId" resultType="java.lang.Long">
        select menu_id from sys_role_menu where role_id = #{roleId} and is_half  = 0
    </select>
</mapper>